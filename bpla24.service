[Unit]
Description=BPLA24 Alert Bot (@bpla24)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bpla24
EnvironmentFile=/opt/bpla24/.env
ExecStart=/opt/bpla24/venv/bin/python main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
